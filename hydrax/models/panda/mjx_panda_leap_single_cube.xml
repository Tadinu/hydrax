<mujoco model="panda single cube">
  <include file="mjx_scene.xml"/>
  <include file="../cube/reorientation_cube.xml"/>

  <worldbody>
    <body name="target" mocap="true" pos="0.325 0.17 0.4" quat="0.70710678 0. 0.70710678 0.">
      <geom type="box" size=".035 .035 .07" mass=".108" material="cube" contype="0" conaffinity="0" group="2"/>
    </body>
  </worldbody>

  <!-- Sensors for the cube -->
  <sensor>
    <framepos name="cube_position" objtype="body" objname="cube"/>
    <contact name="cube_contact_with_palm" geom1="cube" geom2="leap_rh/palm_visual" data="found force" reduce="mindist"/>
    <contact name="cube_contact_with_th_tip" geom1="cube" geom2="leap_rh/th_tip" data="found force" reduce="mindist"/>
    <contact name="cube_contact_with_if_tip" geom1="cube" geom2="leap_rh/if_tip" data="found force" reduce="mindist"/>
    <contact name="cube_contact_with_mf_tip" geom1="cube" geom2="leap_rh/mf_tip" data="found force" reduce="mindist"/>
    <contact name="cube_contact_with_rf_tip" geom1="cube" geom2="leap_rh/rf_tip" data="found force" reduce="mindist"/>
    <framepos name="cube_distance_to_grasp" objtype="body" objname="cube" reftype="site" refname="leap_rh/grasp_site" />
    <framepos name="cube_distance_to_target" objtype="body" objname="cube" reftype="body" refname="target"/>
    <framequat name="cube_orientation" objtype="body" objname="cube"/>
    <framequat name="cube_orientation_from_target" objtype="body" objname="cube" reftype="body" refname="target"/>
    <framelinvel name="cube_linear_vel" objtype="body" objname="cube"/>
    <frameangvel name="cube_angular_vel" objtype="body" objname="cube"/>

    <!-- hand. -->
    <framepos name="palm_position" objtype="site" objname="leap_rh/grasp_site"/>
    <framepos name="th_tip_distance_to_cube" objtype="site" objname="leap_rh/th_tip" reftype="body" refname="cube"/>
    <framepos name="if_tip_distance_to_cube" objtype="site" objname="leap_rh/if_tip" reftype="body" refname="cube"/>
    <framepos name="mf_tip_distance_to_cube" objtype="site" objname="leap_rh/mf_tip" reftype="body" refname="cube"/>
    <framepos name="rf_tip_distance_to_cube" objtype="site" objname="leap_rh/rf_tip" reftype="body" refname="cube"/>

  </sensor>
</mujoco>
