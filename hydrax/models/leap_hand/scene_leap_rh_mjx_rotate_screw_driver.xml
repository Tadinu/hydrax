<mujoco model="leap_scene">
  <include file="leap_rh_mjx.xml"/>
  <include file="../screw_driver/screw_driver.xml"/>

  <statistic center="0.15 0 0" extent="0.4" meansize="0.01"/>
  <size nuserdata="1"/>

  <default>
    <default class="translation">
      <position kp="10" dampratio="1" ctrlrange="-.5 .5"/>
    </default>
    <default class="rotation">
      <!--
      Note that the rotational control range is purposefully limited to (-pi/2, pi/2) to avoid the
      documented instabillity near pi, which is due to taking quaternion differences.
      Increase this range to pi or bigger in order to see the instabillity.
      See here for more details https://mujoco.readthedocs.io/en/latest/XMLreference.html#actuator
      -->
      <position kp=".5" dampratio="1" ctrlrange="-1.571 1.571"/>
    </default>
  </default>

  <visual>
    <headlight diffuse=".8 .8 .8" ambient=".2 .2 .2" specular="1 1 1"/>
    <rgba force="1 0 0 1"/>
    <global azimuth="120" elevation="-20"/>
    <map force="0.01" stiffness="500"/>
    <scale forcewidth="0.1" contactwidth="0.5" contactheight="0.2"/>
    <quality shadowsize="8192"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="1 1 1" rgb2="1 1 1" width="800" height="800"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="1 1 1" rgb2="1 1 1" markrgb="0 0 0"
      width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0"/>
  </asset>

  <default>
    <default class="screw_driver">
      <geom friction="0.3 0.05 0.01" conaffinity="2" />
    </default>
  </default>

  <worldbody>
    <camera name="side" pos="-0.183 0.396 0.296" xyaxes="-0.783 -0.622 -0.000 0.332 -0.419 0.845"/>
    <geom name="floor" pos="0 0 0" size="0 0 0.01" type="plane" material="groundplane" contype="1" conaffinity="1"/>
    <body name="target" mocap="true" pos="-0.05 0 0.1"> <!--pos="0.325 0.17 0.4"-->
      <geom type="box" size=".02 .02 .07" mass=".108" material="oriented_screw_driver" contype="0" conaffinity="0" group="2"/>
      <site name="target_head_a" rgba="0.5 0 0 1" type="sphere" size="0.01" pos="0 0 0.07" />
      <site name="target_head_b" rgba="0 0.5 0 1" type="sphere" size="0.01" pos="0 0 -0.07" />
    </body>
  </worldbody>

  <sensor>
    <!-- screw_driver. -->
    <framepos name="screw_driver_position" objtype="body" objname="screw_driver"/>
    <contact name="screw_driver_contact_with_palm" geom1="screw_driver" geom2="palm_visual" data="found force"/>
    <contact name="screw_driver_contact_with_th_tip" geom1="screw_driver" geom2="th_tip" data="found force"/>
    <contact name="screw_driver_contact_with_if_tip" geom1="screw_driver" geom2="if_tip" data="found force"/>
    <contact name="screw_driver_contact_with_mf_tip" geom1="screw_driver" geom2="mf_tip" data="found force"/>
    <contact name="screw_driver_contact_with_rf_tip" geom1="screw_driver" geom2="rf_tip" data="found force"/>
    <framepos name="screw_driver_distance_to_grasp" objtype="body" objname="screw_driver" reftype="site" refname="grasp_site" />
    <framepos name="screw_driver_distance_to_target" objtype="body" objname="screw_driver" reftype="body" refname="target"/>
    <framequat name="screw_driver_orientation" objtype="body" objname="screw_driver"/>
    <framequat name="screw_driver_orientation_from_target" objtype="body" objname="screw_driver" reftype="body" refname="target"/>
    <framepos name="grasp_distance_from_target" objtype="site" objname="grasp_site" reftype="body" refname="target"/>
    <framelinvel name="screw_driver_linear_vel" objtype="body" objname="screw_driver"/>
    <frameangvel name="screw_driver_angular_vel" objtype="body" objname="screw_driver"/>
    <frameangacc name="screw_driver_angular_acc" objtype="body" objname="screw_driver"/>
    <framezaxis name="screw_driver_upvector" objtype="body" objname="screw_driver"/>

    <framepos name="screw_driver_head_distance_to_target_head_a" objtype="site" objname="screw_driver_head_a"
              reftype="site" refname="target_head_a"/>

    <!-- hand. -->
    <framepos name="palm_position" objtype="site" objname="grasp_site"/>
    <framepos name="th_tip_distance_to_screw_driver" objtype="site" objname="th_tip" reftype="body" refname="screw_driver"/>
    <framepos name="if_tip_distance_to_screw_driver" objtype="site" objname="if_tip" reftype="body" refname="screw_driver"/>
    <framepos name="mf_tip_distance_to_screw_driver" objtype="site" objname="mf_tip" reftype="body" refname="screw_driver"/>
    <framepos name="rf_tip_distance_to_screw_driver" objtype="site" objname="rf_tip" reftype="body" refname="screw_driver"/>

    <!-- goal. -->
    <framequat name="screw_driver_goal_orientation" objtype="body" objname="target"/>
    <framezaxis name="screw_driver_goal_upvector" objtype="body" objname="target"/>
  </sensor>

